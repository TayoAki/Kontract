# Copy this file to .env.local and fill in what you have.
# Every key is optional: without one, that feature runs on sample data or a template.

# SAM.gov opportunities need no key: the app downloads SAM.gov's free daily
# file of every active notice. This optional key only lists a notice's
# attachments. Free: sign in at sam.gov → Profile → "Public API Key".
SAM_API_KEY=

# Claude — plain-English breakdowns, scopes of work, outreach emails and proposals.
# Get one at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Subcontractor search (pick one). Google Places is fastest; Apify reuses the
# compass/crawler-google-places actor from the Agentic Workflows scripts.
GOOGLE_PLACES_API_KEY=
APIFY_API_TOKEN=

# Building permits need no key. A free Socrata app token raises the rate limits.
SOCRATA_APP_TOKEN=

# Accounts. Optional locally (a secret is generated into DATA_DIR); set both in
# production. Secret: openssl rand -base64 32. URL: the public https:// address.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Behind a proxy, the header holding the client's IP (x-real-ip on Railway).
# Sign-in rate limits are per visitor only when this is set.
TRUSTED_IP_HEADER=

# Subcontractors' paid daily-leads plan (Stripe). Without these the plan shows
# as "coming soon". Webhook: https://<your-domain>/api/stripe/webhook for
# checkout.session.completed and customer.subscription.updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# The monthly price shown to subs. Defaults to 99.
DAILY_LEADS_PRICE_USD=

# Lead digest emails to subs (Resend, with a verified sending domain).
# Without these, leads are only in the app.
RESEND_API_KEY=
EMAIL_FROM=
# Hour (UTC) digests go out. Defaults to 12 (about 7am Central).
DIGEST_HOUR_UTC=

# Where accounts, pipelines and caches are saved. Defaults to ./.data
DATA_DIR=
